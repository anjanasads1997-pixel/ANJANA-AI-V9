{
  "name": "anjana-ai-v10",
  "version": "10.2.4",
  "private": true,
  "description": "ANJANA AI V10.2.4 bilingual hybrid assistant: OpenAI primary, Gemini secondary, Ollama offline, LiveAvatar LITE",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "build:client": "esbuild public/app.js --bundle --platform=browser --format=iife --target=es2020 --outfile=public/app.bundle.js",
    "postinstall": "esbuild public/app.js --bundle --platform=browser --format=iife --target=es2020 --outfile=public/app.bundle.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@heygen/liveavatar-web-sdk": "0.0.20",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0"
  }
}
